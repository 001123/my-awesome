---
// Footer mặc định của Starlight + phần tác giả.
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';
import { AUTHOR, t } from '../author';

const s = t(Astro.locals.starlightRoute.lang);
---

<Default><slot /></Default>

<div class="author not-content">
	<img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} alt="" width="40" height="40" />
	<div class="info">
		<span class="label">{s.author}</span>
		<a class="name" href={AUTHOR.url} rel="author">{AUTHOR.name}</a>
	</div>
	<nav aria-label={s.authorLinks}>
		<a href={AUTHOR.url} title="Website"><Icon name="external" /><span class="sr-only">Website</span></a>
		<a href={AUTHOR.github} title="GitHub" rel="me"><Icon name="github" /><span class="sr-only">GitHub</span></a>
		<a href={AUTHOR.x} title="X" rel="me"><Icon name="x.com" /><span class="sr-only">X</span></a>
	</nav>
</div>

<style>
	.author {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-top: 2.5rem;
		padding: 1rem 1.2rem;
		background: var(--aw-card);
		border: 1px solid var(--aw-border);
		border-radius: var(--aw-radius);
	}
	img {
		border-radius: 11px;
	}
	.info {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		flex: 1;
	}
	.label {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.name {
		font-family: var(--aw-font-serif);
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.name:hover {
		color: var(--sl-color-accent);
	}
	nav {
		display: flex;
		gap: 0.25rem;
	}
	nav a {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: 1.15rem;
	}
	nav a:hover {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
</style>
